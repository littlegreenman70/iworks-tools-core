{
	"name": "iworksie/tools-core",
	"description": "Shared core library for the free iWorks.ie Tools WordPress plugin suite.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "iWorks.ie",
			"homepage": "https://www.iworks.ie"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.32",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.11",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"brain/monkey": "^2.6"
	},
	"autoload": {
		"psr-4": {
			"IWorksIE\\Core\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"IWorksIE\\Core\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=512M",
		"test:unit": "IWT_TESTSUITE=unit phpunit --testsuite unit",
		"test:integration": "IWT_TESTSUITE=integration phpunit --testsuite integration",
		"test": [
			"@test:unit",
			"@test:integration"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"brianhenryie/strauss": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
